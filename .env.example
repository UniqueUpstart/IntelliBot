# Optional server-side bootstrap values for deployment.
# Normal desktop use: run `python run.py`, then configure the model in
# Settings -> AI Model. That runtime config is stored in data/ai_config.json.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=replace-with-your-api-key
